# Copy to .env and fill in values before running docker compose.
# All variables are optional unless noted.

# Log level for gateway and tower-http (default: info,witness_gateway=debug in Docker)
RUST_LOG=info,witness_gateway=debug

# REQUIRED to enable the admin dashboard (--admin-ui flag also needed on the CLI).
# Generate with: openssl rand -hex 32
WITNESS_ADMIN_API_KEY=

# Protects the WebSocket event stream at /v1/events.
# If unset, the endpoint is unauthenticated.
# Generate with: openssl rand -hex 32
WITNESS_WS_AUTH_TOKEN=

# Bearer token required to scrape Prometheus metrics at /metrics.
# If unset, /metrics is unauthenticated.
# Generate with: openssl rand -hex 32
WITNESS_METRICS_TOKEN=

# Set to true when the gateway is behind a reverse proxy (nginx, Caddy, etc.)
# so that X-Forwarded-For is trusted for rate limiting.
# Leave false when binding directly to the internet.
WITNESS_BEHIND_PROXY=false
